#!/usr/bin/env fish

set location $argv[1]
set bold $(tput bold)
set normal $(tput sgr0)
set non_permanent_fs tmpfs devtmpfs

if not test -e $location
    echo "given location doesn't exist: $location"
    exit 1
end

set file_system (df $location | tail -n 1 | cut -d " " -f1)

echo "filesystem is:$bold $file_system$normal"

if contains -- $file_system $non_permanent_fs
    echo "and is thus:$bold NOT preserved"
    exit 1
else
    echo "and is thus:$bold preserved"
    exit 0
end
